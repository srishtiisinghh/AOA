1.	MENU DRIVEN ARRAY OP

#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, ch, i;

    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n < 1) { printf("Invalid size\n"); return 1; }

    int *a = malloc(n * sizeof *a);
    if (!a) { printf("Out of memory\n"); return 1; }

    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++)
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input\n"); free(a); return 1; }

    do {
        printf("\n--- MENU ---\n"
               "1. Display all elements\n"
               "2. Sum and average\n"
               "3. Largest and smallest\n"
               "4. Count even and odd\n"
               "0. Exit\n"
               "Enter choice: ");
        if (scanf("%d", &ch) != 1)
        break;

        long long sum = 0;
        int min = a[0], max = a[0], even = 0;

        switch (ch) {
            case 1:
                printf("Elements: ");
                for (i = 0; i < n; i++) printf("%d ", a[i]);
                printf("\n");
                break;
            case 2:
                for (i = 0; i < n; i++) sum += a[i];
                printf("Sum = %lld, Average = %.2f\n", sum, (double)sum / n);
                break;
            case 3:
                for (i = 1; i < n; i++) {
                    if (a[i] < min) min = a[i];
                    if (a[i] > max) max = a[i];
                }
                printf("Largest = %d, Smallest = %d\n", max, min);
                break;
            case 4:
                for (i = 0; i < n; i++) even += (a[i] % 2 == 0);
                printf("Even = %d, Odd = %d\n", even, n - even);
                break;
            case 0:
                printf("Exiting...\n");
                break;
            default:
                printf("Invalid choice\n");
        }
    } while (ch != 0); 

    free(a);
    return 0;
}


2.	DELETE AN ARRAY AT SPECIFIED ARRAY POSITION

#include <stdio.h>
#define MAX 100

void show(int a[], int n) {
    printf("Array: ");
    for (int i = 0; i < n; i++) printf("%d ", a[i]);
    printf("%s\n", n ? "" : "(empty)");
}

int main(void) {
    int a[MAX], n, i, p, x, ch;

    printf("Enter n (0-%d): ", MAX);
    if (scanf("%d", &n) != 1 || n < 0 || n > MAX) { printf("Invalid size\n"); return 1; }

    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++)
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input\n"); return 1; }
    show(a, n);

    do {
        printf("\n1.Insert 2.Delete 0.Exit: ");
        if (scanf("%d", &ch) != 1) break;

        if (ch == 1) {
            if (n == MAX) { printf("Array is full\n"); continue; }
            printf("Position (1-%d): ", n + 1);
            if (scanf("%d", &p) != 1 || p < 1 || p > n + 1) { printf("Invalid position\n"); break; }
            printf("Value: ");
            if (scanf("%d", &x) != 1) { printf("Invalid value\n"); break; }
            for (i = n; i >= p; i--) a[i] = a[i - 1];
            a[p - 1] = x;
            n++;
            show(a, n);
        } else if (ch == 2) {
            if (n == 0) { printf("Array is empty\n"); continue; }
            printf("Position (1-%d): ", n);
            if (scanf("%d", &p) != 1 || p < 1 || p > n) { printf("Invalid position\n"); break; }
            printf("Deleted %d\n", a[p - 1]);
            for (i = p - 1; i < n - 1; i++) a[i] = a[i + 1];
            n--;
            show(a, n);
        } else if (ch != 0) {
            printf("Invalid choice\n");
        }
    } while (ch != 0);

    return 0;
}

3.	REVERSE AN ARRAY WITHOUT A SECOND ARRAY
#include <stdio.h>

int main(void) {
    int a[100], n, i, temp;

    printf("Enter number of elements (1-100): ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 100) { printf("Invalid size\n"); return 1; }

    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++)
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input\n"); return 1; }

    printf("Original array: ");
    for (i = 0; i < n; i++) printf("%d ", a[i]);

    for (i = 0; i < n / 2; i++) {      /* swap a[i] with a[n-1-i] */
        temp = a[i];
        a[i] = a[n - 1 - i];
        a[n - 1 - i] = temp;
    }

    printf("\nReversed array: ");
    for (i = 0; i < n; i++) printf("%d ", a[i]);
    printf("\n");
    return 0;
}

4.	STACK USING AN ARRAY

#include <stdio.h>
#define CAP 5
int main(void)
{
    int stack[CAP], top = -1, ch, x, i;
    do {
        printf("\n--- STACK MENU (capacity %d) ---\n", CAP);
        printf("1. PUSH  2. POP  3. PEEK  4. DISPLAY  0. Exit\nEnter choice: ");
        if (scanf("%d", &ch) != 1)
            break;
        switch (ch) {
        case 1:
            if (top == CAP - 1) {
                printf("Stack Overflow! Cannot push.\n");
            } else {
                printf("Enter value: ");
                scanf("%d", &x);
                stack[++top] = x;
                printf("%d pushed\n", x);
            }
            break;
        case 2:
            if (top == -1)
                printf("Stack Underflow! Cannot pop.\n");
            else
                printf("Popped %d\n", stack[top--]);
            break;
        case 3:
            if (top == -1)
                printf("Stack is empty\n");
            else
                printf("Top element = %d\n", stack[top]);
            break;
        case 4:
            if (top == -1) {
                printf("Stack is empty\n");
            } else {
                printf("Stack (top to bottom): ");
                for (i = top; i >= 0; i--)
                    printf("%d ", stack[i]);
                printf("\n");
            }
            break;
        case 0:
            printf("Exiting...\n");
            break;
        default:
            printf("Invalid choice\n");
        }
    } while (ch != 0);
    return 0;
}

5.	REVERSE A STRING USING AN ARRAY STACK
#include <stdio.h>
#include <string.h>
int main(void)
{
    char str[200], stack[200];
    int i, top = -1;
    printf("Enter a string: ");
    if (!fgets(str, sizeof str, stdin))
        return 0;
    str[strcspn(str, "\n")] = '\0';
    for (i = 0; str[i] != '\0'; i++)    /* push every character */
        stack[++top] = str[i];
    printf("Reversed string: ");
    while (top >= 0)                    /* pop gives reverse order */
        putchar(stack[top--]);
    printf("\n");
    return 0;
}

6.	PARANTHESES
#include <stdio.h>
#include <string.h>
int main(void)
{
    char expr[200], stack[200], c;
    int i, top = -1, balanced = 1;
    printf("Enter an expression: ");
    if (!fgets(expr, sizeof expr, stdin))
        return 0;
    expr[strcspn(expr, "\n")] = '\0';
    for (i = 0; expr[i] != '\0'; i++) {
        c = expr[i];
        if (c == '(' || c == '{' || c == '[') {
            stack[++top] = c;                       /* push opening bracket */
        } else if (c == ')' || c == '}' || c == ']') {
            if (top == -1 ||
                (c == ')' && stack[top] != '(') ||
                (c == '}' && stack[top] != '{') ||
                (c == ']' && stack[top] != '[')) {
                balanced = 0;                       /* extra or mismatched */
                break;
            }
            top--;                                  /* pop matching bracket */
        }
    }
    if (top != -1)
        balanced = 0;                               /* unclosed opening bracket */
    printf("%s\n", balanced ? "Balanced" : "Not balanced");
    return 0;
}
7.	LINEAR QUEUE USING ARRAY
#include <stdio.h>
#define MAX 5

int main(void) {
    int q[MAX], f = 0, r = -1, ch, x, i;

    do {
        printf("\n1.Enqueue 2.Dequeue 3.Peek 4.Display 0.Exit: ");
        if (scanf("%d", &ch) != 1) break;

        if (ch == 1) {
            if (r == MAX - 1) printf("Overflow\n");
            else { printf("Value: "); scanf("%d", &x); q[++r] = x; }
        } else if (ch == 2) {
            if (f > r) printf("Underflow\n");
            else printf("Dequeued %d\n", q[f++]);
        } else if (ch == 3) {
            if (f > r) printf("Queue empty\n");
            else printf("Front = %d\n", q[f]);
        } else if (ch == 4) {
            if (f > r) printf("Queue empty\n");
            else { for (i = f; i <= r; i++) printf("%d ", q[i]); printf("\n"); }
        }
    } while (ch != 0);

    return 0;
}
