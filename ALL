#include <stdio.h>
void selection(int a[], int n, int *c, int *s) {
    int i, j, m, t;
    *c = *s = 0;
    for (i = 0; i < n - 1; i++) {
        m = i;
        for (j = i + 1; j < n; j++) {
            (*c)++;
            if (a[j] < a[m]) m = j;
        }
        if (m != i) { t = a[i]; a[i] = a[m]; a[m] = t; (*s)++; }
    }
}
