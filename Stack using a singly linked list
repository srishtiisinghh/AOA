Implement a stack using a singly linked list. Provide PUSH, POP, PEEK, and DISPLAY operations. Handle the empty-stack
condition.

#include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *next; };
int main() {
    struct node *top = NULL, *p;
    int ch;
    do {
        printf("\n1.Push 2.Pop 3.Peek 4.Display 0.Exit: "); scanf("%d", &ch);
        if (ch == 1) {
            p = malloc(sizeof(struct node));
            printf("Value: "); scanf("%d", &p->data);
            p->next = top; top = p;
        } else if (ch == 2) {
            if (top == NULL) printf("Stack empty");
            else { p = top; printf("Popped %d", p->data); top = top->next; free(p); }
        } else if (ch == 3) {
            if (top == NULL) printf("Stack empty"); else printf("Top = %d", top->data);
        } else if (ch == 4) {
            if (top == NULL) printf("Stack empty");
            else for (p = top; p; p = p->next) printf("%d ", p->data);
        }
    } while (ch != 0);
    return 0;
}




 #include <stdio.h>
#include <stdlib.h>
struct Node {
    int data;
    struct Node *next;
};
int main(void)
{
    struct Node *top = NULL, *p;
    int ch, x;
    do {
        printf("\n--- STACK USING LINKED LIST ---\n");
        printf("1. PUSH  2. POP  3. PEEK  4. DISPLAY  0. Exit\nEnter choice: ");
        if (scanf("%d", &ch) != 1)
            break;
        switch (ch) {
        case 1:
            printf("Enter value: ");
            scanf("%d", &x);
            p = (struct Node *)malloc(sizeof(struct Node));
            if (p == NULL) {
                printf("Memory allocation failed\n");
                return 1;
            }
            p->data = x;
            p->next = top;      /* new node points to old top */
            top = p;
            printf("%d pushed\n", x);
            break;
        case 2:
            if (top == NULL) {
                printf("Stack is empty (Underflow)\n");
            } else {
                p = top;
                printf("Popped %d\n", p->data);
                top = top->next;
                free(p);
            }
            break;
        case 3:
            if (top == NULL)
                printf("Stack is empty\n");
            else
                printf("Top element = %d\n", top->data);
            break;
        case 4:
            if (top == NULL) {
                printf("Stack is empty\n");
            } else {
                printf("Stack (top to bottom): ");
                for (p = top; p != NULL; p = p->next)
                    printf("%d ", p->data);
                printf("\n");
            }
            break;
        case 0:
            printf("Exiting...\n");
            break;
        default:
            printf("Invalid choice\n");
        }
    } while (ch != 0);
    while (top != NULL) {
        p = top;
        top = top->next;
        free(p);
    }
    return 0;
}

    return 0;
}
