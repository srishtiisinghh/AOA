            }
            printf("Enter value: ");
            scanf("%d", &x);
            for (i = n; i >= pos; i--)      /* shift right, from the end */
                a[i] = a[i - 1];
            a[pos - 1] = x;
            n++;
            display(a, n);
        } else if (ch == 2) {
            if (n == 0) {
                printf("Array is empty\n");
                continue;
            }
            printf("Enter position (1 to %d): ", n);
            scanf("%d", &pos);
            if (pos < 1 || pos > n) {
                printf("Invalid position\n");
                continue;
            }
            printf("Deleted %d\n", a[pos - 1]);
            for (i = pos - 1; i < n - 1; i++)   /* shift left */
                a[i] = a[i + 1];
            n--;
            display(a, n);
        } else if (ch != 0) {
            printf("Invalid choice\n");
        }
    } while (ch != 0);
    return 0;
}
