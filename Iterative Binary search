Write an iterative binary search program to find a target element in a sorted array. Display its position if found; otherwise, display
an appropriate message.

#include <stdio.h>
int main() {
    int a[100], n, t, i, lo, hi, mid;
    printf("Enter n: "); scanf("%d", &n);
    printf("Enter sorted elements: ");
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    printf("Target: "); scanf("%d", &t);
    lo = 0; hi = n - 1;
    while (lo <= hi) {
        mid = (lo + hi) / 2;
        if (a[mid] == t) { printf("Found at position %d\n", mid + 1); return 0; }
        if (a[mid] < t) lo = mid + 1; else hi = mid - 1;
    }
    printf("Not found\n");
    return 0;
}





#include <stdio.h>
int main(void)
{
    int a[100], n, target, i, low, high, mid;
    printf("Enter number of elements (1-100): ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 100) {
        printf("Invalid size\n");
        return 0;
    }
    printf("Enter %d integers in ascending order: ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    for (i = 1; i < n; i++) {
        if (a[i] < a[i - 1]) {
            printf("Array is not sorted. Binary search needs sorted input.\n");
            return 0;
        }
    }
    printf("Enter target value: ");
    scanf("%d", &target);
    low = 0;
    high = n - 1;
    while (low <= high) {
        mid = low + (high - low) / 2;
        if (a[mid] == target) {
            printf("%d found at position %d\n", target, mid + 1);
            return 0;
        } else if (a[mid] < target) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    printf("%d not found in the array\n", target);
    return 0;
}
