Write an iterative binary search program to find a target element in a sorted array. Display its position if found; otherwise, display
an appropriate message.

#include <stdio.h>
int main() {
    int a[100], n, t, i, lo, hi, mid;
    printf("Enter n: "); scanf("%d", &n);
    printf("Enter sorted elements: ");
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    printf("Target: "); scanf("%d", &t);
    lo = 0; hi = n - 1;
    while (lo <= hi) {
        mid = (lo + hi) / 2;
        if (a[mid] == t) { printf("Found at position %d\n", mid + 1); return 0; }
        if (a[mid] < t) lo = mid + 1; else hi = mid - 1;
    }
    printf("Not found\n");
    return 0;
}
