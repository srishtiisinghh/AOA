Write a C++ program to accept n integer elements into an array and perform the following operations using
a menu-driven program: 1. Display all elements. 2. Find the sum and average. 3. Find the largest and smallest
elements. 4. Count even and odd elements

#include <stdio.h>
int main(void)
{
    int a[100], n, i, ch, sum, even, odd, min, max;
    printf("Enter number of elements (1-100): ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 100) {
        printf("Invalid size\n");
        return 0;
    }
    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    do {
        printf("\n--- MENU ---\n");
        printf("1. Display all elements\n");
        printf("2. Sum and average\n");
        printf("3. Largest and smallest\n");
        printf("4. Count even and odd\n");
        printf("0. Exit\n");
        printf("Enter choice: ");
        if (scanf("%d", &ch) != 1)
            break;
        switch (ch) {
        case 1:
            printf("Elements: ");
            for (i = 0; i < n; i++)
                printf("%d ", a[i]);
            printf("\n");
            break;
        case 2:
            sum = 0;
            for (i = 0; i < n; i++)
                sum += a[i];
            printf("Sum = %d, Average = %.2f\n", sum, (double)sum / n);
            break;
        case 3:
            min = max = a[0];
            for (i = 1; i < n; i++) {
                if (a[i] < min) min = a[i];
                if (a[i] > max) max = a[i];
            }
            printf("Largest = %d, Smallest = %d\n", max, min);
            break;
        case 4:
            even = odd = 0;
            for (i = 0; i < n; i++) {
                if (a[i] % 2 == 0) even++;
                else odd++;
            }
            printf("Even = %d, Odd = %d\n", even, odd);
            break;
        case 0:
            printf("Exiting...\n");
            break;
        default:
            printf("Invalid choice\n");
        }
    } while (ch != 0);
    return 0;
}
