Write a C++ program to sort an array of integers in ascending order using the bubble sort algorithm. Display the array after each
pass.

#include <stdio.h>
int main() {
    int a[100], n, i, j, k, t;
    printf("Enter n: "); scanf("%d", &n);
    printf("Enter elements: ");
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++)
            if (a[j] > a[j + 1]) { t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; }
        printf("Pass %d: ", i + 1);
        for (k = 0; k < n; k++) printf("%d ", a[k]);
        printf("\n");
    }
    return 0;
}



#include <stdio.h>
int main(void)
{
    int a[100], n, i, j, k, temp;
    printf("Enter number of elements (1-100): ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 100) {
        printf("Invalid size\n");
        return 0;
    }
    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    for (i = 0; i < n - 1; i++) {               /* pass number */
        for (j = 0; j < n - 1 - i; j++) {       /* compare adjacent elements */
            if (a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
        printf("After pass %d: ", i + 1);
        for (k = 0; k < n; k++)
            printf("%d ", a[k]);
        printf("\n");
    }
    printf("Sorted array: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
    return 0;
}
