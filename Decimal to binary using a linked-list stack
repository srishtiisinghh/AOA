Write a program to convert a positive decimal integer into its binary equivalent using a stack implemented
with a linked list. Push the remainders obtained by repeated division by 2, then pop them to display the binary
number.

#include <stdio.h>
#include <stdlib.h>
struct node { int bit; struct node *next; };
int main() {
    struct node *top = NULL, *p;
    int n;
    printf("Enter a positive integer: "); scanf("%d", &n);
    if (n <= 0) { printf("Invalid\n"); return 0; }
    while (n > 0) {
        p = malloc(sizeof(struct node));
        p->bit = n % 2; p->next = top; top = p;
        n /= 2;
    }
    printf("Binary: ");
    while (top) { p = top; printf("%d", p->bit); top = top->next; free(p); }
    printf("\n");
    return 0;
}





