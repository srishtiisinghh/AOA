Write a C++ program to accept n integer elements into an array and perform the following operations using
a menu-driven program: 1. Display all elements. 2. Find the sum and average. 3. Find the largest and smallest
elements. 4. Count even and odd elements

#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, ch, i;

    printf("Enter number of elements: ");
    if (scanf("%d", &n) != 1 || n < 1) { printf("Invalid size\n"); return 1; }

    int *a = malloc(n * sizeof *a);
    if (!a) { printf("Out of memory\n"); return 1; }

    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++)
        if (scanf("%d", &a[i]) != 1) { printf("Invalid input\n"); free(a); return 1; }

    do {
        printf("\n--- MENU ---\n"
               "1. Display all elements\n"
               "2. Sum and average\n"
               "3. Largest and smallest\n"
               "4. Count even and odd\n"
               "0. Exit\n"
               "Enter choice: ");
        if (scanf("%d", &ch) != 1) break;

        long long sum = 0;
        int min = a[0], max = a[0], even = 0;

        switch (ch) {
            case 1:
                printf("Elements: ");
                for (i = 0; i < n; i++) printf("%d ", a[i]);
                printf("\n");
                break;
            case 2:
                for (i = 0; i < n; i++) sum += a[i];
                printf("Sum = %lld, Average = %.2f\n", sum, (double)sum / n);
                break;
            case 3:
                for (i = 1; i < n; i++) {
                    if (a[i] < min) min = a[i];
                    if (a[i] > max) max = a[i];
                }
                printf("Largest = %d, Smallest = %d\n", max, min);
                break;
            case 4:
                for (i = 0; i < n; i++) even += (a[i] % 2 == 0);
                printf("Even = %d, Odd = %d\n", even, n - even);
                break;
            case 0:
                printf("Exiting...\n");
                break;
            default:
                printf("Invalid choice\n");
        }
    } while (ch != 0);

    free(a);
    return 0;
}
