Write a program to create a singly linked list containing n integer elements. Display the elements from the
first node to the last node and count the total number of nodes.

#include <stdio.h>
#include <stdlib.h>
struct Node {
    int data;
    struct Node *next;
};
int main(void)
{
    struct Node *head = NULL, *tail = NULL, *p, *tmp;
    int n, i, x, count = 0;
    printf("Enter number of nodes: ");
    if (scanf("%d", &n) != 1 || n < 0) {
        printf("Invalid input\n");
        return 0;
    }
    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &x);
        p = (struct Node *)malloc(sizeof(struct Node));
        if (p == NULL) {
            printf("Memory allocation failed\n");
            return 1;
        }
        p->data = x;
        p->next = NULL;
        if (head == NULL)
            head = p;           /* first node */
        else
            tail->next = p;     /* link after last node */
        tail = p;
    }
    printf("Linked list: ");
    for (p = head; p != NULL; p = p->next) {
        printf("%d ", p->data);
        count++;
    }
    printf("\nTotal number of nodes = %d\n", count);
    while (head != NULL) {      /* free all nodes */
        tmp = head;
        head = head->next;
        free(tmp);
    }
    return 0;
}
