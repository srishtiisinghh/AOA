Write a program to delete a node from the beginning, the end, or a specified position in a singly linked list. Also implement a
search operation to find a given value and report its position.

include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *next; } *head = NULL;
void show() {
    struct node *p;
    printf("List: ");
    for (p = head; p; p = p->next) printf("%d ", p->data);
    printf("\n");
}
int main() {
    struct node *p, *prev, *tail = NULL;
    int n, i, x, pos, ch, found;
    printf("Enter n: "); scanf("%d", &n);
    printf("Enter elements: ");
    for (i = 0; i < n; i++) {
        p = malloc(sizeof(struct node));
        scanf("%d", &p->data); p->next = NULL;
        if (head == NULL) head = p; else tail->next = p;
        tail = p;
    }
    show();
    do {
        printf("1.Del first 2.Del last 3.Del position 4.Search 0.Exit: "); scanf("%d", &ch);
        if (ch == 4) {
            printf("Value: "); scanf("%d", &x); found = 0;
            for (p = head, i = 1; p; p = p->next, i++)
                if (p->data == x) { printf("Found at position %d\n", i); found = 1; }
            if (!found) printf("Not found\n");
        } else if (ch >= 1 && ch <= 3) {
            if (head == NULL) { printf("List empty\n"); continue; }
            pos = 1;
            if (ch == 2) for (pos = 0, p = head; p; p = p->next) pos++;
            if (ch == 3) { printf("Position: "); scanf("%d", &pos); }
            for (prev = NULL, p = head, i = 1; p && i < pos; i++) { prev = p; p = p->next; }
            if (pos < 1 || p == NULL) { printf("Invalid\n"); continue; }
            if (prev) prev->next = p->next; else head = p->next;
            printf("Deleted %d\n", p->data); free(p);
            show();
        }
    } while (ch != 0);
    return 0;
}
