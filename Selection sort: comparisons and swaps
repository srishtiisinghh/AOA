Write a program to implement selection sort and count the total comparisons and swaps. Test the algorithm on an unsorted array
and an already sorted array, and compare the operation counts.


#include <stdio.h>
void selection(int a[], int n, int *c, int *s) {
    int i, j, m, t;
    *c = *s = 0;
    for (i = 0; i < n - 1; i++) {
        m = i;
        for (j = i + 1; j < n; j++) {
            (*c)++;
            if (a[j] < a[m]) m = j;
        }
        if (m != i) { t = a[i]; a[i] = a[m]; a[m] = t; (*s)++; }
    }
}
int main() {
    int a[100], n, i, c1, s1, c2, s2;
    printf("Enter n: "); scanf("%d", &n);
    printf("Enter elements: ");
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    selection(a, n, &c1, &s1);
    selection(a, n, &c2, &s2);
    printf("Sorted: ");
    for (i = 0; i < n; i++) printf("%d ", a[i]);
    printf("\nUnsorted input : %d comparisons, %d swaps\n", c1, s1);
    printf("Sorted input   : %d comparisons, %d swaps\n", c2, s2);
    return 0;
}









#include <stdio.h>
#define MAX 100
void selection(int a[], int n, int *cmp, int *swp)
{
    int i, j, min, temp;
    *cmp = 0;
    *swp = 0;
    for (i = 0; i < n - 1; i++) {
        min = i;
        for (j = i + 1; j < n; j++) {
            (*cmp)++;
            if (a[j] < a[min])
                min = j;
        }
        if (min != i) {
            temp = a[i];
            a[i] = a[min];
            a[min] = temp;
            (*swp)++;
        }
    }
}
int main(void)
{
    int a[MAX], b[MAX], n, i, c1, s1, c2, s2;
    printf("Enter number of elements (1-%d): ", MAX);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Invalid size\n");
        return 0;
    }
    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    selection(a, n, &c1, &s1);                  /* a is now sorted */
    for (i = 0; i < n; i++)
        b[i] = a[i];
    selection(b, n, &c2, &s2);                  /* run again on sorted data */
    printf("\nSorted array: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n\n%-18s %-13s %s\n", "Input", "Comparisons", "Swaps");
    printf("%-18s %-13d %d\n", "Unsorted (given)", c1, s1);
    printf("%-18s %-13d %d\n", "Already sorted", c2, s2);
    return 0;
}
