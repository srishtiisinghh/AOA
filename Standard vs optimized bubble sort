Implement standard bubble sort and optimized bubble sort to sort the same array. Count and compare
their comparisons and swaps for an already sorted array and a reverse-sorted array.


#include <stdio.h>
void bubble(int a[], int n, int opt, int *c, int *s) {
    int i, j, t, sw;
    *c = *s = 0;
    for (i = 0; i < n - 1; i++) {
        sw = 0;
        for (j = 0; j < n - 1 - i; j++) {
            (*c)++;
            if (a[j] > a[j + 1]) { t = a[j]; a[j] = a[j + 1]; a[j + 1] = t; (*s)++; sw = 1; }
        }
        if (opt && !sw) break;
    }
}
void test(const char *name, int a[], int n) {
    int x[100], y[100], i, c1, s1, c2, s2;
    for (i = 0; i < n; i++) x[i] = y[i] = a[i];
    bubble(x, n, 0, &c1, &s1);
    bubble(y, n, 1, &c2, &s2);
    printf("%-15s Standard: %d cmp, %d swaps | Optimized: %d cmp, %d swaps\n",
           name, c1, s1, c2, s2);
}
int main() {
    int a[100], r[100], n, i, c, s;
    printf("Enter n: "); scanf("%d", &n);
    printf("Enter elements: ");
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    test("Given", a, n);
    bubble(a, n, 0, &c, &s);
    test("Already sorted", a, n);
    for (i = 0; i < n; i++) r[i] = a[n - 1 - i];
    test("Reverse sorted", r, n);
    return 0;
}






#include <stdio.h>
#define MAX 100
/* Bubble sort. optimized = 1 stops early when a pass makes no swap. */
void bubble(int a[], int n, int optimized, int *cmp, int *swp)
{
    int i, j, temp, swapped;
    *cmp = 0;
    *swp = 0;
    for (i = 0; i < n - 1; i++) {
        swapped = 0;
        for (j = 0; j < n - 1 - i; j++) {
            (*cmp)++;
            if (a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
                (*swp)++;
                swapped = 1;
            }
        }
        if (optimized && !swapped)
            break;
    }
}
/* Runs both versions on copies of src and prints the counts. */
void test(const char *title, int src[], int n)
{
    int x[MAX], y[MAX], i, c1, s1, c2, s2;
    for (i = 0; i < n; i++)
        x[i] = y[i] = src[i];
    bubble(x, n, 0, &c1, &s1);
    bubble(y, n, 1, &c2, &s2);
    printf("%-16s | Standard: cmp=%-3d swaps=%-3d | Optimized: cmp=%-3d swaps=%-3d\n",
  title, c1, s1, c2, s2);
}
int main(void)
{
    int a[MAX], sorted[MAX], rev[MAX], n, i, c, s;
    printf("Enter number of elements (1-%d): ", MAX);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Invalid size\n");
        return 0;
    }
    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    for (i = 0; i < n; i++)
        sorted[i] = a[i];
    bubble(sorted, n, 1, &c, &s);               /* ascending copy */
    for (i = 0; i < n; i++)
        rev[i] = sorted[n - 1 - i];             /* descending copy */
    printf("\n");
    test("Given array", a, n);
    test("Already sorted", sorted, n);
    test("Reverse sorted", rev, n);
    return 0;
}
