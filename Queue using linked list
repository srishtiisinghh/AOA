Implement a queue using a linked list with front and rear pointers. Provide ENQUEUE, DEQUEUE, PEEK,
and DISPLAY operations. Update both pointers correctly when the queue becomes empty.

#include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *next; };
int main() {
    struct node *f = NULL, *r = NULL, *p;
    int ch;
    do {
        printf("\n1.Enqueue 2.Dequeue 3.Peek 4.Display 0.Exit: "); scanf("%d", &ch);
        if (ch == 1) {
            p = malloc(sizeof(struct node));
            printf("Value: "); scanf("%d", &p->data); p->next = NULL;
            if (r == NULL) f = r = p; else { r->next = p; r = p; }
        } else if (ch == 2) {
            if (f == NULL) printf("Queue empty");
            else {
                p = f; printf("Dequeued %d", p->data);
                f = f->next;
                if (f == NULL) r = NULL;
                free(p);
            }
        } else if (ch == 3) {
            if (f == NULL) printf("Queue empty"); else printf("Front = %d", f->data);
        } else if (ch == 4) {
            if (f == NULL) printf("Queue empty");
            else for (p = f; p; p = p->next) printf("%d ", p->data);
        }
    } while (ch != 0);
    return 0;
}










#include <stdio.h>
#include <stdlib.h>
struct Node {
    int data;
    struct Node *next;
};
int main(void)
{
    struct Node *front = NULL, *rear = NULL, *p;
    int ch, x;
    do {
        printf("\n--- QUEUE USING LINKED LIST ---\n");
        printf("1. ENQUEUE  2. DEQUEUE  3. PEEK  4. DISPLAY  0. Exit\nEnter choice: ");
        if (scanf("%d", &ch) != 1)
            break;
        switch (ch) {
        case 1:
            printf("Enter value: ");
            scanf("%d", &x);
            p = (struct Node *)malloc(sizeof(struct Node));
            if (p == NULL) {
                printf("Memory allocation failed\n");
                return 1;
            }
            p->data = x;
            p->next = NULL;
            if (rear == NULL)           /* queue was empty */
                front = rear = p;
            else {
                rear->next = p;
                rear = p;
            }
            printf("%d enqueued\n", x);
            break;
        case 2:
            if (front == NULL) {
                printf("Queue is empty (Underflow)\n");
            } else {
                p = front;
                printf("Dequeued %d\n", p->data);
                front = front->next;
                if (front == NULL)      /* queue became empty */
                    rear = NULL;
                free(p);
            }
            break;
        case 3:
            if (front == NULL)
                printf("Queue is empty\n");
            else
                printf("Front element = %d\n", front->data);
            break;
        case 4:
            if (front == NULL) {
                printf("Queue is empty\n");
            } else {
                printf("Queue (front to rear): ");
                for (p = front; p != NULL; p = p->next)
                    printf("%d ", p->data);
                printf("\n");
            }
            break;
        case 0:
            printf("Exiting...\n");
            break;
        default:
            printf("Invalid choice\n");
        }
    } while (ch != 0);
    while (front != NULL) {
        p = front;
        front = front->next;
        free(p);
    }
    return 0;
}
