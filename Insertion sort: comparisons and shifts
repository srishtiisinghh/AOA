Implement insertion sort and count the number of comparisons and shifts. Test the program using an
already sorted array, a reverse-sorted array, and a randomly arranged array. Compare the results and explain the
best-case and worst-case time complexity.

#include <stdio.h>
void insertion(int a[], int n, int *c, int *s) {
    int i, j, key;
    *c = *s = 0;
    for (i = 1; i < n; i++) {
        key = a[i];
        for (j = i - 1; j >= 0; j--) {
            (*c)++;
            if (a[j] <= key) break;
            a[j + 1] = a[j]; (*s)++;
        }
        a[j + 1] = key;
    }
}
void test(const char *name, int a[], int n) {
    int x[100], i, c, s;
    for (i = 0; i < n; i++) x[i] = a[i];
    insertion(x, n, &c, &s);
    printf("%-15s %d comparisons, %d shifts\n", name, c, s);
}
int main() {
    int a[100], r[100], n, i, c, s;
    printf("Enter n: "); scanf("%d", &n);
    printf("Enter elements (random order): ");
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    test("Random", a, n);
    insertion(a, n, &c, &s);
    test("Already sorted", a, n);
    for (i = 0; i < n; i++) r[i] = a[n - 1 - i];
    test("Reverse sorted", r, n);
    printf("Best case (sorted): O(n). Worst case (reverse sorted): O(n^2).\n");
    return 0;
}










#include <stdio.h>
#define MAX 100
void insertion(int a[], int n, int *cmp, int *shifts)
{
    int i, j, key;
    *cmp = 0;
    *shifts = 0;
    for (i = 1; i < n; i++) {
        key = a[i];
        j = i - 1;
        while (j >= 0) {
            (*cmp)++;
            if (a[j] > key) {
                a[j + 1] = a[j];
                (*shifts)++;
                j--;
            } else {
                break;
            }
        }
        a[j + 1] = key;
    }
}
void test(const char *title, int src[], int n)
{
    int x[MAX], i, c, s;
    for (i = 0; i < n; i++)
        x[i] = src[i];
    insertion(x, n, &c, &s);
    printf("%-16s %-13d %d\n", title, c, s);
}
int main(void)
{
    int a[MAX], sorted[MAX], rev[MAX], n, i, c, s;
    printf("Enter number of elements (1-%d): ", MAX);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Invalid size\n");
        return 0;
    }
    printf("Enter %d integers (random order): ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    for (i = 0; i < n; i++)
        sorted[i] = a[i];
    insertion(sorted, n, &c, &s);               /* ascending copy */
    for (i = 0; i < n; i++)
        rev[i] = sorted[n - 1 - i];             /* descending copy */
    printf("\n%-16s %-13s %s\n", "Input", "Comparisons", "Shifts");
    test("Random (given)", a, n);
    test("Already sorted", sorted, n);
    test("Reverse sorted", rev, n);
    printf("\nBest case (already sorted): no shifts, n-1 comparisons -> O(n).\n");
    printf("Worst case (reverse sorted): every key moves to the front,\n");
    printf("so n(n-1)/2 comparisons and shifts -> O(n^2).\n");
    return 0;
}
