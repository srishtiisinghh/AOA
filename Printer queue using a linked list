                for (p = front; p != NULL; p = p->next)
                    printf("  Job ID = %d, Pages = %d\n", p->id, p->pages);
            }
            break;
        case 0:
            printf("Exiting...\n");
            break;
        default:
            printf("Invalid choice\n");
        }
    } while (ch != 0);
    while (front != NULL) {
        p = front;
        front = front->next;
        free(p);
    }
    return 0;
}
