Circular queue using an array of fixed capacity. Perform insertion, deletion, and display
operations while reusing vacant positions created by deletion.

#include <stdio.h>
#define SIZE 5

int main(void) {
    int q[SIZE], f = 0, r = 0, count = 0, ch, x, i;

    do {
        printf("\n1.Insert 2.Delete 3.Display 0.Exit: ");
        if (scanf("%d", &ch) != 1) break;

        if (ch == 1) {
            if (count == SIZE) printf("Queue is full\n");
            else {
                printf("Value: ");
                scanf("%d", &x);
                q[r] = x;
                r = (r + 1) % SIZE;
                count++;
            }
        } else if (ch == 2) {
            if (count == 0) printf("Queue is empty\n");
            else {
                printf("Deleted %d\n", q[f]);
                f = (f + 1) % SIZE;
                count--;
            }
        } else if (ch == 3) {
            if (count == 0) printf("Queue is empty\n");
            else {
                for (i = 0; i < count; i++) printf("%d ", q[(f + i) % SIZE]);
                printf("\n");
            }
        }
    } while (ch != 0);

    return 0;
}
