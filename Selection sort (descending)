Modify the selection sort algorithm to arrange array elements in descending order. Display the original
array, each pass, and the final sorted array.

#include <stdio.h>
int main() {
    int a[100], n, i, j, k, m, t;
    printf("Enter n: "); scanf("%d", &n);
    printf("Enter elements: ");
    for (i = 0; i < n; i++) scanf("%d", &a[i]);
    printf("Original: ");
    for (i = 0; i < n; i++) printf("%d ", a[i]);
    printf("\n");
    for (i = 0; i < n - 1; i++) {
        m = i;
        for (j = i + 1; j < n; j++)
            if (a[j] > a[m]) m = j;
        t = a[i]; a[i] = a[m]; a[m] = t;
        printf("Pass %d: ", i + 1);
        for (k = 0; k < n; k++) printf("%d ", a[k]);
        printf("\n");
    }
    return 0;
}






#include <stdio.h>
int main(void)
{
    int a[100], n, i, j, k, max, temp;
    printf("Enter number of elements (1-100): ");
    if (scanf("%d", &n) != 1 || n < 1 || n > 100) {
        printf("Invalid size\n");
        return 0;
    }
    printf("Enter %d integers: ", n);
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);
    printf("Original array: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
    for (i = 0; i < n - 1; i++) {
        max = i;                                /* index of largest in unsorted part */
        for (j = i + 1; j < n; j++)
            if (a[j] > a[max])
                max = j;
        if (max != i) {
            temp = a[i];
            a[i] = a[max];
            a[max] = temp;
        }
        printf("After pass %d: ", i + 1);
        for (k = 0; k < n; k++)
            printf("%d ", a[k]);
        printf("\n");
    }
    printf("Sorted (descending): ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
    return 0;
}
