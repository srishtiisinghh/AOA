Write a program to accept a string, push each character onto a stack implemented using an array, and pop
the characters to display the string in reverse order

#include <stdio.h>
#include <string.h>
int main(void)
{
    char str[200], stack[200];
    int i, top = -1;
    printf("Enter a string: ");
    if (!fgets(str, sizeof str, stdin))
        return 0;
    str[strcspn(str, "\n")] = '\0';
    for (i = 0; str[i] != '\0'; i++)    /* push every character */
        stack[++top] = str[i];
    printf("Reversed string: ");
    while (top >= 0)                    /* pop gives reverse order */
        putchar(stack[top--]);
    printf("\n");
    return 0;
}
