Create a stack using a linked list, insert at least five integer elements, and display the stack from top to bottom. Pop all elements
to display them in reverse insertion order.

#include <stdio.h>
#include <stdlib.h>
struct node { int data; struct node *next; };
int main() {
    struct node *top = NULL, *p;
    int i;
    printf("Enter 5 integers: ");
    for (i = 0; i < 5; i++) {
        p = malloc(sizeof(struct node));
        scanf("%d", &p->data);
        p->next = top; top = p;
    }
    printf("Stack (top to bottom): ");
    for (p = top; p; p = p->next) printf("%d ", p->data);
    printf("\nPopped: ");
    while (top) { p = top; printf("%d ", p->data); top = top->next; free(p); }
    printf("\n");



